{
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "description": "ChitChat real-time backend: Socket.IO matchmaking + anonymous chat server.",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "@chitchat/server",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "0.1.0"
