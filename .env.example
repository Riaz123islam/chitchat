# ─── ChitChat environment template ──────────────────────────────────────────────
# Copy to .env (and to apps/server/.env / apps/web/.env.local for local dev).
# NEVER commit real values. See README.md for setup instructions.

# ── Server (apps/server) ─────────────────────────────────────────────────────
# Port the Socket.IO server listens on (Render injects PORT automatically).
PORT=4000

# Public URL of the socket server, e.g. https://chitchat-server.onrender.com
# Used for CORS validation responses and keep-alive pings.
SOCKET_SERVER_URL=http://localhost:4000

# Comma-separated list of origins allowed to use the WebSocket API + REST.
# Local dev default covers the Next.js dev server. In production set this to
# your Vercel frontend URL, e.g. https://chitchat.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
# Public URL of the deployed frontend, e.g. https://chitchat.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the socket server the browser connects to.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Redis / Upstash (matchmaking queue + presence) ────────────────────────────
# REST credentials from the Upstash console. If unset, the server falls back
# to an in-memory queue (fine for a single instance / local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: plain redis:// URL if you prefer the Redis protocol via ioredis.
# (Not used by default; the REST client is preferred on free tiers.)
REDIS_URL=

# ── Supabase (PostgreSQL: sessions, rooms, reports, blocks) ──────────────────
# Optional. When set, reports/blocks/session/room records persist to Supabase.
# When unset, moderation data is kept in memory only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key is not needed by the server; the frontend never talks to
# Supabase directly.

# ── Abuse protection ─────────────────────────────────────────────────────────
# Cloudflare Turnstile. When both are set, new sessions must pass the widget
# challenge (the frontend shows it automatically).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
